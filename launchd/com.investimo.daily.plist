<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.investimo.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/path/to/investimo/.venv/bin/python</string>
    <string>-m</string>
    <string>investimo.main</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/path/to/investimo</string>

  <!-- 16:30 LOCAL time, Mon-Fri: adjust if this machine isn't on US Eastern.
       last_session() resolves to the latest completed NYSE session, so
       holidays and a late run are both harmless. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <!-- Don't run on load. A slot missed while asleep still runs on wake:
       launchd coalesces missed StartCalendarInterval fires. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/path/to/investimo/data/daily.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/investimo/data/daily.log</string>
</dict>
</plist>
